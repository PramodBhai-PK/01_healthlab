{
  "name": "01-healthlab-suite",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web",
    "admin"
  ],
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "dev:admin": "npm run dev --prefix admin",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\" \"npm run dev:admin\"",
    "build": "npm run build --workspaces",
    "start": "node server/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
