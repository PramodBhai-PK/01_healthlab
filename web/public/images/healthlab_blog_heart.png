<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <linearGradient id="cardGrad_KeepHeartHealthy" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00897B" />
      <stop offset="100%" stop-color="#004D40" />
    </linearGradient>
    <pattern id="pattern_KeepHeartHealthy" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="#ffffff" opacity="0.08" />
    </pattern>
  </defs>
  <rect width="600" height="400" rx="16" fill="url(#cardGrad_KeepHeartHealthy)" />
  <rect width="600" height="400" fill="url(#pattern_KeepHeartHealthy)" />
  <circle cx="520" cy="80" r="120" fill="#4DB6AC" opacity="0.15" />
  <circle cx="100" cy="340" r="90" fill="#ffffff" opacity="0.07" />
  
  <g transform="translate(60, 80)">
    <circle cx="50" cy="50" r="46" fill="#ffffff" opacity="0.95" />
    <text x="50" y="62" font-family="'Segoe UI', Roboto, sans-serif" font-size="34" text-anchor="middle" fill="#004D40">❤️</text>
    
    <text x="120" y="45" font-family="'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="700" fill="#ffffff">Keep Heart Healthy</text>
    <text x="120" y="75" font-family="'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="400" fill="#ffffff" opacity="0.85">Cardiovascular Care</text>
  </g>

  <rect x="60" y="220" width="480" height="120" rx="12" fill="#ffffff" opacity="0.12" />
  <circle cx="100" cy="280" r="18" fill="#ffffff" opacity="0.3" />
  <circle cx="100" cy="280" r="8" fill="#ffffff" />
  <text x="135" y="275" font-family="'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="600" fill="#ffffff">Certified Healthcare Excellence</text>
  <text x="135" y="298" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" fill="#ffffff" opacity="0.8">Advanced clinical precision & evidence-based medical protocol</text>
</svg>